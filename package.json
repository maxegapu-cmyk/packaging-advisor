{
  "name": "packaging-advisor",
  "version": "0.1.0",
  "private": true,
  "description": "包装视觉顾问 Packaging Advisor — packaging visual directions for e-commerce sellers",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "TSX_TSCONFIG_PATH=tsconfig.node.json node --import tsx --test tests/*.test.ts tests/*.test.mts",
    "invites": "tsx --tsconfig tsconfig.node.json scripts/invites.ts",
    "preview:board": "tsx --tsconfig tsconfig.node.json scripts/render-preview.tsx"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.170.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
