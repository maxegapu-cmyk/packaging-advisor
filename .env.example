# 复制为 .env 后填写 Copy to .env and fill in.

# 必填：用于加密 API Key 和会话，至少 16 个字符。生成方法：openssl rand -base64 32
# Required: encrypts API keys and sessions; at least 16 characters. Generate with: openssl rand -base64 32
APP_SECRET=

# 可选：指定第一个管理员邀请码（至少 8 位字母或数字）。不填则首次启动时自动生成并打印在日志里。
# Optional: a fixed first admin invite code (8+ letters or digits). If empty, one is generated and printed in the log on first start.
ADMIN_INVITE_CODE=

# 网站对外地址，用于生成分享链接。 Public address of the site, used in share links.
PUBLIC_URL=http://localhost:3000

# 每位测试者每天的生成与修改次数上限（管理员不受限）。 Daily generations + revisions per tester (admins are unlimited).
DAILY_GENERATION_LIMIT=30

# 单次模型调用超时（毫秒）与最大输出长度。 Model call timeout (ms) and max output tokens.
LLM_TIMEOUT_MS=240000
LLM_MAX_TOKENS=12000

# 设为 off 可去掉内置的离线演示模型。 Set to off to remove the built-in offline demo model.
DEMO_PROVIDER=on

# 网站使用 HTTP（没有 HTTPS）时设为 false，否则登录 Cookie 不会生效。
# Set to false when the site is served over plain HTTP, otherwise the sign-in cookie is not kept.
COOKIE_SECURE=false

# 数据目录（数据库与上传图片）。 Data directory (database and uploads).
# DATA_DIR=./data

# 可选：瘦金体网页字体。瘦金体没有免费商用的字库，请向方正（方正瘦金书）或汉仪（汉仪瘦金书）购买
# 同时覆盖网页嵌入和印刷品的商用授权，把字体文件（建议 WOFF2）放进 public/fonts/shoujin/，再在这里
# 写上它的地址。构建时写入页面，修改后需要重新构建（docker compose build）。不填时题字与题签用
# 开源的朱雀仿宋（已内置）。
# Optional: a 瘦金体 (Slender Gold) web font. No 瘦金体 font is free for commercial use: buy a
# licence covering web embedding and printed products from FounderType (方正瘦金书) or Hanyi
# (汉仪瘦金书), put the file (WOFF2 preferred) in public/fonts/shoujin/ and give its address here.
# It is built into the pages, so rebuild after changing it (docker compose build). Without it,
# inscriptions and title slips use the bundled open-source 朱雀仿宋 (Zhuque Fangsong).
# NEXT_PUBLIC_SHOUJIN_FONT_URL=/fonts/shoujin/FZShouJinShu.woff2
